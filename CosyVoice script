from pathlib import Path

from cosyvoice.cli.cosyvoice import CosyVoice

from cosyvoice.utils.file_utils import load_wav

import torchaudio

SCRIPT_FOLDER = Path(__file__).parent

SENTENCES_FILE = Path.home() / "sentences.txt"

OUTPUT_FOLDER = SCRIPT_FOLDER / "outputs"

OUTPUT_FOLDER.mkdir(exist_ok=True)

cosyvoice = CosyVoice("pretrained_models/CosyVoice-300M")

with open(SENTENCES_FILE, "r", encoding="utf-8") as f:

    sentences = [line.strip() for line in f if line.strip()]

VOICE = "English Male"

for number, text in enumerate(sentences, start=1):

    print(f"Generating sentence {number}")

    output_file = OUTPUT_FOLDER / f"cosyvoice_{number:02d}.wav"

    for result in cosyvoice.inference_sft(

        text,

        VOICE,

    ):

        torchaudio.save(

            str(output_file),

            result["tts_speech"],

            cosyvoice.sample_rate,

        )

    print(f"Saved {output_file}")

print("Finished.")

