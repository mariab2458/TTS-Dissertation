import os

from pathlib import Path

from dotenv import load_dotenv

from elevenlabs.client import ElevenLabs

load_dotenv(Path.home() / ".env")

api_key = os.getenv("ELEVENLABS_API_KEY")

if not api_key:

    raise ValueError("ELEVENLABS_API_KEY was not found in your .env file.")

client = ElevenLabs(api_key=api_key)

VOICE_ID = "JBFqnCBsd6RMkjVDRZzb" #neutral adult male

MODEL_ID = "eleven_multilingual_v2"

SCRIPT_FOLDER = Path(__file__).parent

SENTENCES_FILE = Path.home() / "sentences.txt"

OUTPUT_FOLDER = SCRIPT_FOLDER / "outputs-ma"

OUTPUT_FOLDER.mkdir(exist_ok=True)

with open(SENTENCES_FILE, "r", encoding="utf-8") as file:

    sentences = [line.strip() for line in file if line.strip()]

for number, text in enumerate(sentences, start=1):

    print(f"Generating sentence {number}: {text}")

    audio = client.text_to_speech.convert(

        voice_id=VOICE_ID,

        model_id=MODEL_ID,

        text=text,

        output_format="mp3_44100_128",

    )

    output_file = OUTPUT_FOLDER / f"elevenlabs_{number:02d}.mp3"

    with open(output_file, "wb") as file:

        for chunk in audio:

            file.write(chunk)

    print(f"Saved: {output_file}")

print("Finished generating all sentences.")

