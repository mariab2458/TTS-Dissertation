from TTS.api import TTS

from pathlib import Path

import torch

device = "cuda" if torch.cuda.is_available() else "cpu"

tts = TTS(

    "tts_models/multilingual/multi-dataset/xtts_v2"

).to(device)

SPEAKER = "Aaron Dreschner" # neutral adult male

LANGUAGE = "en"   # en, es, ru, zh-cn

SCRIPT_FOLDER = Path(__file__).parent

SENTENCES_FILE = SCRIPT_FOLDER.parent / "sentences.txt"

OUTPUT_FOLDER = SCRIPT_FOLDER / "outputs"

OUTPUT_FOLDER.mkdir(exist_ok=True)

with open(SENTENCES_FILE, "r", encoding="utf-8") as file:

    sentences = [line.strip() for line in file if line.strip()]

for number, text in enumerate(sentences, start=1):

    print(f"Generating sentence {number}: {text}")

    output_file = OUTPUT_FOLDER / f"xtts_{number:02d}.wav"

    tts.tts_to_file(

        text=text,

        speaker=SPEAKER,

        language=LANGUAGE,

        file_path=str(output_file)

    )

    print(f"Saved: {output_file}")

print("Finished generating all sentences.")
