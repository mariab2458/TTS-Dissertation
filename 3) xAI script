import os

from pathlib import Path

import requests

from dotenv import load_dotenv

load_dotenv(Path.home() / ".env")

api_key = os.getenv("XAI_API_KEY")

if not api_key:

    raise ValueError("XAI_API_KEY was not found in ~/.env")

SCRIPT_FOLDER = Path(__file__).parent

SENTENCES_FILE = Path.home() / "sentences.txt"

OUTPUT_FOLDER = SCRIPT_FOLDER / "outputs"

OUTPUT_FOLDER.mkdir(exist_ok=True)

with open(SENTENCES_FILE, "r", encoding="utf-8") as f:

    sentences = [line.strip() for line in f if line.strip()]

headers = {

    "Authorization": f"Bearer {api_key}",

    "Content-Type": "application/json",

}

VOICE = "leo" #neutral adult male

for number, text in enumerate(sentences, start=1):

    print(f"Generating sentence {number}...")

    response = requests.post(

        "https://api.x.ai/v1/tts",

        headers=headers,

        json={

            "text": text,

            "voice_id": VOICE,

            "language": "en"

        },

        timeout=120,

    )

    response.raise_for_status()

    output_file = OUTPUT_FOLDER / f"xai_{number:02d}.mp3"

    with open(output_file, "wb") as f:

        f.write(response.content)

    print(f"Saved {output_file}")

print("Finished.")


